# ---------------------------------------------------------------- database
# Neon pooled connection string in production; the local Docker container in dev.
DATABASE_URL=postgres://postgres:dev@localhost:5433/yugantar

# ------------------------------------------------------------------- app
# Used in the links inside emails, including sign-in links. Must be the address
# people actually reach the app on, or the links will point at the wrong host.
APP_URL=http://localhost:3000
# Restricts sign-in to the college Google Workspace domain (PRD 13). Invited
# Management users may sit outside it; everyone else may not.
ALLOWED_EMAIL_DOMAIN=sst.scaler.com

# ------------------------------------------------------------------ auth
# Two ways in, and only one is ever offered. With these set, sign-in is Clerk's
# Google flow restricted to ALLOWED_EMAIL_DOMAIN (PRD 13). Left empty, the app
# emails a one-time sign-in link instead. Either way access follows an invitation:
# nobody signs themselves up.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk's own name for it is CLERK_WEBHOOK_SIGNING_SECRET; both are read.
CLERK_WEBHOOK_SECRET=

# --------------------------------------------------------------- bootstrap
# Who `pnpm db:seed` makes the first Finance HOD, who is also the platform
# administrator (PRD open question 14). They add departments and invite everyone
# else from /admin. Only read at bootstrap; changing it later does nothing.
BOOTSTRAP_ADMIN_EMAIL=ajij.24bcs10103@sst.scaler.com
BOOTSTRAP_ADMIN_NAME=Ajij Uttam
BOOTSTRAP_FEST_NAME=Yugaantar '26
BOOTSTRAP_FEST_SLUG=yugaantar-26

# ----------------------------------------------------------------- files
# Cloudflare R2, private bucket. Unset, uploads go to ./.uploads instead and the
# presign → PUT → complete flow behaves identically.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override for MinIO or Supabase Storage.
R2_ENDPOINT=
# Signs the local-disk upload and download URLs. Required only when running
# without R2 in production.
UPLOAD_URL_SECRET=

# ----------------------------------------------------------------- email
# Unset, emails are logged rather than sent and the notification row stays unsent.
# Sign-in links are logged too, so a fresh deployment can still get its first
# administrator in — but nobody else will receive their invitation.
RESEND_API_KEY=
EMAIL_FROM="Yugaantar Finance <finance@yugaantar.org>"

# -------------------------------------------------------------------- ai
# Receipt OCR (PRD 8.1) and the model-based flags are v1.1.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ jobs
# Bearer token for /api/v1/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=dev-cron-secret
