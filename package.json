{
  "name": "yugantar-finance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "tsx db/migrate.mts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local db/migrate.mts",
    "db:seed": "tsx --env-file=.env.local db/seed.mts",
    "db:studio": "drizzle-kit studio",
    "env:check": "tsx infra/env-check.mts",
    "r2:check": "tsx --env-file=.env.local infra/r2-check.mts",
    "smoke": "tsx --env-file=.env.local infra/smoke.mts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "responsive": "tsx --env-file=.env.local infra/responsive.mts",
    "walkthrough:pdf": "tsx infra/walkthrough-pdf.mts",
    "loadtest": "tsx --env-file=.env.local infra/loadtest.mts"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.3.0"
}
